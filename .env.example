# ---------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env)
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------------
# BACKEND (NODE.JS + EXPRESS + MONGOOSE) CONFIGURATION (backend/.env)
# ---------------------------------------------------------------------
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/trace_dev
FRONTEND_URL=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_KEY=trace_internal_secret_key_change_me_in_production
ML_TIMEOUT_MS=1500

# JWT & Authentication Configuration
JWT_ACCESS_SECRET=trace_dev_access_secret_super_secure_key_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ---------------------------------------------------------------------
# ML INFERENCE SERVICE (PYTHON + FASTAPI) CONFIGURATION (ml-service/.env)
# ---------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
INTERNAL_SERVICE_KEY=trace_internal_secret_key_change_me_in_production
